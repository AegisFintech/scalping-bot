[Unit]
Description=Prospective loss-control diagnostics; no broker or provider authority
After=scalper-observation-feed.service

[Service]
Type=oneshot
User=scalper-flight
Group=scalper-flight
StateDirectory=scalper-loss-control529
StateDirectoryMode=0700
WorkingDirectory=/var/lib/scalper-loss-control529
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/scalper-loss-control529
ExecStart=/opt/scalper-loss-control529/.venv/bin/python -P -m python.operations.loss_control_study run --directory /var/lib/scalper-loss-control529
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scalper-loss-control529
InaccessiblePaths=-/root -/etc/scalping-bot -/etc/scalper-flight -/etc/scalper-codex-entry -/run/postgresql
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
LimitFSIZE=16M
TimeoutStartSec=60
