# Install as /etc/ctrader-ai-scalper/ctrader-ai-scalper.env, root:ctrader-scalper 0640.
# Add secrets locally; never copy the populated file back into the repository.
APP_ENV=production
HOST=127.0.0.1
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACKNOWLEDGEMENT=
DEMO_TRADING_ENABLED=false
DEMO_TRADING_ACKNOWLEDGEMENT=
AUTOMATIC_ANALYSIS_ENABLED=false
EMERGENCY_STOP=true
EMERGENCY_STOP_FILE=/var/lib/ctrader-ai-scalper/emergency-stop
LIVE_ENABLEMENT_FILE=/var/lib/ctrader-ai-scalper/live-enabled
CTRADER_TOKEN_STATE_FILE=/var/lib/ctrader-ai-scalper/ctrader-token-state.json
LOCAL_LOG_DIR=/var/log/ctrader-ai-scalper
DATABASE_SSL_MODE=require
DASHBOARD_CONTROL_TOKEN=
