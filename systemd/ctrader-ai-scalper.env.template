# Install as /etc/ctrader-ai-scalper/ctrader-ai-scalper.env, root:ctrader-scalper 0640.
# Add secrets locally; never copy the populated file back into the repository.
APP_ENV=production
HOST=127.0.0.1
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACKNOWLEDGEMENT=
DEMO_TRADING_ENABLED=false
DEMO_TRADING_ACKNOWLEDGEMENT=
AUTOMATIC_ANALYSIS_ENABLED=false
AUTOMATIC_ANALYSIS_COMPLETED_LIMIT=0
AUTOMATIC_ANALYSIS_COMPLETED_BASELINE=0
AUTOMATIC_DEMO_CLOSED_TRADE_LIMIT=0
AUTOMATIC_DEMO_CLOSED_TRADE_BASELINE=0
ANALYSIS_SCHEDULER_LEAD_MS=1000
AUTOMATIC_ANALYSIS_STALL_SECONDS=180
MODEL_MINIMUM_CALL_BUDGET_SECONDS=40
MODEL_POST_RESPONSE_RESERVE_SECONDS=5
MIN_EXPECTED_NET_TO_FEES_RATIO=1
AI_REASONING_EFFORT=
EMERGENCY_STOP=true
EMERGENCY_STOP_FILE=/var/lib/ctrader-ai-scalper/emergency-stop
LIVE_ENABLEMENT_FILE=/var/lib/ctrader-ai-scalper/live-enabled
CTRADER_TOKEN_STATE_FILE=/var/lib/ctrader-ai-scalper/ctrader-token-state.json
LOCAL_LOG_DIR=/var/log/ctrader-ai-scalper
DATABASE_SSL_MODE=require
DASHBOARD_CONTROL_TOKEN=
BETTERSTACK_ENABLED=false
BETTERSTACK_INGESTING_HOST=
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_OUTBOX_INTERVAL_SECONDS=5
BETTERSTACK_OUTBOX_BATCH_SIZE=50
BETTERSTACK_OUTBOX_LEASE_SECONDS=30
BETTERSTACK_OUTBOX_RETRY_BASE_SECONDS=5
BETTERSTACK_OUTBOX_RETRY_MAX_SECONDS=300
