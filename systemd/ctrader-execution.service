[Unit]
Description=cTrader AI Scalper execution and safety coordinator
After=network-online.target ctrader-analytics.service ctrader-market-data.service ctrader-ai.service
Wants=network-online.target ctrader-analytics.service ctrader-market-data.service ctrader-ai.service

[Service]
Type=simple
User=ctrader-scalper
Group=ctrader-scalper
WorkingDirectory=/opt/ctrader-ai-scalper/current
EnvironmentFile=/etc/ctrader-ai-scalper/ctrader-ai-scalper.env
ExecStart=/usr/bin/node dist/apps/execution-service/src/index.js
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ReadWritePaths=/var/lib/ctrader-ai-scalper /var/log/ctrader-ai-scalper
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=ctrader-ai-scalper.target
