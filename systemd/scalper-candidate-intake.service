[Unit]
Description=Append-only Codex candidate intake (no trading authority)

[Service]
Type=oneshot
User=scalper-research
Group=scalper-research
WorkingDirectory=/var/lib/scalper-research
Environment=HOME=/var/lib/scalper-research
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/scalper-candidate-lab/current
ExecStart=/opt/scalper-research/.venv/bin/python -m python.research.candidate_lab --directory /var/lib/scalper-research/candidate-lab scan --reports /var/lib/scalper-research/jobs
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
LimitFSIZE=32M
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scalper-research/candidate-lab
InaccessiblePaths=-/root -/opt/ctrader-ai-scalper -/run/postgresql
RestrictAddressFamilies=AF_UNIX
