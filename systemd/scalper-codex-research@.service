[Unit]
Description=Isolated Codex research proposal (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scalper-research
Group=scalper-research
WorkingDirectory=/var/lib/scalper-research
Environment=HOME=/var/lib/scalper-research
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/scalper-research
ExecStart=/opt/scalper-research/.venv/bin/python -m python.research.codex_loop --directory /var/lib/scalper-research/jobs --input /var/lib/scalper-research/inbox/latest.json --kind %i
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
LimitFSIZE=1M
TimeoutStartSec=240
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scalper-research
InaccessiblePaths=-/root -/opt/ctrader-ai-scalper -/run/postgresql
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
