[Unit]
Description=Independent isolated holding-time software checks
After=network.target
[Service]
Type=oneshot
User=scalper-experiment
Group=scalper-experiment
WorkingDirectory=/opt/scalper-holding-worker
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/scalper-holding-worker
ExecStart=/opt/scalper-holding-worker/.venv/bin/python -m python.operations.holding_workers work --config /etc/scalper-holding-worker/scoring.json
UMask=0077
MemoryMax=512M
MemorySwapMax=0
TasksMax=32
CPUQuota=50%
TimeoutStartSec=90
KillMode=control-group
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/scalper-experiment-worker/holding464
