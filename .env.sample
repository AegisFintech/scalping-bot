# Breakout demo policy, entry prompt, model, risk and service defaults live in versioned code.
# Starts stopped/paper. Credentials never authorize live execution.
# See docs/configuration.md before migrating an existing populated environment.

# Account identity and explicit trading authorization
INSTANCE_ID=local-1
TRADING_MODE=paper
DEMO_TRADING_ENABLED=false
DEMO_TRADING_ACKNOWLEDGEMENT=
EMERGENCY_STOP=true
AUTOMATIC_ANALYSIS_ENABLED=false
TRADING_SYMBOL=XAUUSD
ACCOUNT_ID=
ACCOUNT_KEY=unconfigured

# Connections and credentials
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CODEX_ENTRY_LOCAL_TOKEN=
DATABASE_URL=
DASHBOARD_CONTROL_TOKEN=
