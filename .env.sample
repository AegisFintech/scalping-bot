# Safe template only. Copy to .env outside production systemd deployments.
# Never commit populated secrets. Empty required values fail closed.

# Application
APP_ENV=development
APP_NAME=ctrader-ai-scalper
LOG_LEVEL=info
HOST=127.0.0.1
API_PORT=8080
MARKET_DATA_PORT=8081
AI_ORCHESTRATOR_PORT=8082
DASHBOARD_PORT=8501
ANALYTICS_PORT=8090
TIMEZONE=UTC
INSTANCE_ID=local-1

# Trading mode: replay | backtest | paper | demo | shadow | live
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# Required exact value is documented in docs/demo-to-live-checklist.md; keep empty.
LIVE_TRADING_ACKNOWLEDGEMENT=
DEMO_TRADING_ENABLED=false
# Required exact demo acknowledgement is documented in docs/demo-to-live-checklist.md.
DEMO_TRADING_ACKNOWLEDGEMENT=
EMERGENCY_STOP=true
EMERGENCY_STOP_FILE=.runtime/emergency-stop
LIVE_ENABLEMENT_FILE=.runtime/live-enabled
SHADOW_MODE=true
PAUSE_NEW_ANALYSES=false
# Reconciliation and maintenance continue when false; cycles then require an
# authenticated manual request. Keep false for the first supervised demo.
AUTOMATIC_ANALYSIS_ENABLED=false
# Zero disables this inference-cost boundary. A positive value counts only
# durable completed external-AI responses for the immutable strategy release.
AUTOMATIC_ANALYSIS_COMPLETED_LIMIT=0
# Keep zero for a new campaign. A non-zero value is allowed only as an audited
# carry-forward after its prior durable count is verified during a bug-fix release.
AUTOMATIC_ANALYSIS_COMPLETED_BASELINE=0
# Separate terminal-outcome target for demo evidence. Rejections and unfilled
# expiries do not increment it. Keep a finite completed-AI limit above as the
# inference-cost backstop.
AUTOMATIC_DEMO_CLOSED_TRADE_LIMIT=0
AUTOMATIC_DEMO_CLOSED_TRADE_BASELINE=0
SHUTDOWN_CANCEL_PENDING=true
RUNTIME_CONTROL_POLL_SECONDS=2
ANALYSIS_INTERVAL_SECONDS=5
# Align the five-second cadence one second before each wall-clock boundary so
# reconciliation can finish near the broker M1 open without extra polling.
ANALYSIS_SCHEDULER_LEAD_MS=1000
# Automatic cycles start only during this broker-time M1 opening window. Ten
# seconds accommodates mandatory broker reconciliation before the durable claim.
AUTOMATIC_ANALYSIS_START_WINDOW_SECONDS=10
# Alert when live market observations continue but no automatic lifecycle
# progress is recorded for this many seconds. This does not bypass safety gates.
AUTOMATIC_ANALYSIS_STALL_SECONDS=180
# Do not begin paid inference unless enough broker-M1 time remains for the
# response and deterministic post-model checks.
MODEL_MINIMUM_CALL_BUDGET_SECONDS=40
MODEL_POST_RESPONSE_RESERVE_SECONDS=5

# Symbol and account
TRADING_SYMBOL=XAUUSD
SYMBOL_DISCOVERY_ENABLED=true
SYMBOL_ID=
ACCOUNT_ID=
ACCOUNT_TYPE=demo
# Pseudonymous account correlation key; never use the raw broker account ID.
# Keep distinct stable values for paper, demo, and live histories.
ACCOUNT_KEY=unconfigured
ACCOUNT_CURRENCY=USD
BLOCK_ON_MANUAL_SYMBOL_ORDERS=true
BLOCK_ON_MANUAL_SYMBOL_POSITIONS=true

# cTrader. Tokens expire; the client detects expiry, refreshes and reconnects.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCESS_TOKEN_EXPIRES_AT=
CTRADER_REFRESH_TOKEN=
CTRADER_TOKEN_STATE_FILE=.runtime/ctrader-token-state.json
CTRADER_TOKEN_URL=
CTRADER_API_HOST=
CTRADER_API_PORT=
CTRADER_CONNECTION_MODE=demo
CTRADER_RECONNECT_MIN_MS=1000
CTRADER_RECONNECT_MAX_MS=30000
CTRADER_REQUEST_TIMEOUT_MS=10000
# Reconcile unresolved local demo execution state against bounded broker history.
DEMO_EXECUTION_RECOVERY_INTERVAL_SECONDS=15

# Candles and payload
BARS_15M=300
BARS_5M=500
BARS_1M=600
USE_COMPLETED_CANDLES_ONLY=true
MODEL_PAYLOAD_MODE=compact
MODEL_FULL_CANDLE_LIMIT_15M=300
MODEL_FULL_CANDLE_LIMIT_5M=500
MODEL_FULL_CANDLE_LIMIT_1M=600
MODEL_COMPACT_RAW_TAIL_15M=12
MODEL_COMPACT_RAW_TAIL_5M=18
MODEL_COMPACT_RAW_TAIL_1M=30
MAX_CANDLE_SKEW_MS=5000

# Indicators
ATR_PERIOD=15
ATR_SMOOTHING=wilder
EMA_FAST_PERIOD=5
EMA_SLOW_PERIOD=19
EMA_SOURCE=close
VWAP_ENABLED=true
SESSION_VWAP_ENABLED=true
ADX_ENABLED=true
ADX_PERIOD=14
RSI_ENABLED=true
RSI_PERIOD=14
BOLLINGER_ENABLED=false
BOLLINGER_PERIOD=20
BOLLINGER_STDDEV=2
REALIZED_VOLATILITY_ENABLED=true
VOLUME_FEATURES_ENABLED=true
SWING_STRUCTURE_ENABLED=true
PERFORMANCE_MINIMUM_SAMPLES=20
PERFORMANCE_DECAY=0.97
PERFORMANCE_ROLLING_TRADES=200
SWING_PIVOT_LEFT=3
SWING_PIVOT_RIGHT=3
SPREAD_FEATURES_ENABLED=true
ORDER_BOOK_IMBALANCE_ENABLED=true

# Order book
ORDER_BOOK_DEPTH=20
ORDER_BOOK_SNAPSHOT_TIMEOUT_MS=3000
ORDER_BOOK_MAX_AGE_MS=3000
SYMBOL_METADATA_MAX_AGE_MS=86400000
MAX_QUOTE_AGE_MS=3000
ORDER_BOOK_AGGREGATION_ENABLED=true
ORDER_BOOK_AGGREGATION_WINDOWS=1m,5m,15m

# AI endpoint. The service never logs the key or an Authorization header.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_STYLE=responses
AI_TIMEOUT_MS=60000
# One attempt per durable broker-M1 scheduler claim; retry next fresh minute.
AI_MAX_RETRIES=0
AI_TEMPERATURE=0
AI_STRICT_JSON=true
AI_SCHEMA_VERSION=2.1
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=3000
# Omit for provider default; supported values are low, medium, and high.
AI_REASONING_EFFORT=
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_RESET_SECONDS=300

# Risk. BASE_RISK_PERCENT starts at 1%; 5% is a hard ceiling, never a target.
BASE_RISK_PERCENT=1
MAX_RISK_PERCENT=5
MAX_DAILY_LOSS_PERCENT=10
DAILY_RISK_TIMEZONE=UTC
DAILY_BASELINE_CAPTURE_GRACE_SECONDS=300
INCLUDE_UNREALIZED_IN_DAILY_LOSS=true
# Effective reward:risk is 1:2: TP is one unit and SL is two units.
MIN_RISK_REWARD_RATIO=0.5
# Conservative broker-native slippage default; confirm for the broker symbol.
MAX_SLIPPAGE_BPS=2
MAX_SLIPPAGE_POINTS=5
SPREAD_FILTER_MODE=adaptive
MAX_SPREAD_POINTS=
MAX_SPREAD_ATR_RATIO=0.10
MAX_SPREAD_PERCENTILE=95
SPREAD_PERCENTILE_MINIMUM_SAMPLES=30
SPREAD_SESSION_ABNORMAL_MULTIPLIER=3
# Demo submission will not start without a positive daily order-group limit and
# a positive per-position notional cap.
MAX_ORDERS_PER_DAY=0
LOSS_COOLDOWN_SECONDS=0
MAX_OPEN_POSITIONS_PER_SYMBOL=1
MAX_PENDING_ORDERS_PER_SYMBOL=2
ACCOUNT_EQUITY_FLOOR=
ORDER_EXPIRY_MIN_SECONDS=15
ORDER_EXPIRY_MAX_SECONDS=1800
PREFERRED_ORDER_EXPIRY_SECONDS=1500
MIN_STOP_DISTANCE_POINTS=
MAX_STOP_DISTANCE_ATR=3
# Each conditional confirmation must remain within this many M1 ATRs of the
# current executable side of the quote.
MAX_ENTRY_DISTANCE_ATR=2.5
MAX_POSITION_NOTIONAL=
MAX_MARGIN_USAGE_PERCENT=30

# Paper account assumptions are simulation-only and must be labelled as such.
PAPER_ACCOUNT_EQUITY=10000
PAPER_ACCOUNT_BALANCE=10000
PAPER_AVAILABLE_MARGIN=10000
PAPER_MARGIN_PER_NATIVE_VOLUME=1
PAPER_SLIPPAGE_POINTS=0

# Database
DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=require

# Better Stack and OpenTelemetry
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
BETTERSTACK_ENABLED=false
BETTERSTACK_HEARTBEAT_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LOCAL_LOG_DIR=logs
LOCAL_LOG_MAX_SIZE_MB=20
LOCAL_LOG_MAX_FILES=10

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
SERVER_STATS_INTERVAL_SECONDS=10
NETWORK_INTERFACE=

# Dashboard/control API: localhost is the safe default. A reverse proxy must auth.
# Generate an independent value of at least 24 characters; never commit it.
DASHBOARD_CONTROL_TOKEN=
TRUST_PROXY=false

# GitHub delivery. Use a rotated, least-privilege token only in the ignored local .env.
# Never embed a token in GH_REPO, a Git remote URL, logs, issues, or commits.
GH_REPO=https://github.com/AegisFintech/scalping-bot
GH_USER=AegisWalletApp
GH_PAT=
