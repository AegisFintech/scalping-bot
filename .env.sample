# Fixed risk v4: 1% per setup, 5% daily. Starts stopped; live execution is unavailable.
# See docs/configuration.md before migrating an existing .env. Preserve credentials.
# No starting-equity floor or notional cap. Sizing uses equity, stop risk and broker margin.
# Strategy, AI tuning, risk percentages, ports and broker defaults are managed in code.
# Pending orders use GTC (no timer expiry); fresh analysis follows a confirmed close.
# Reusable scenario maps add no tuning settings; see docs/reusable-scenario-report.md.

# Account identity and explicit trading authorization
INSTANCE_ID=local-1
TRADING_MODE=paper
DEMO_TRADING_ENABLED=false
DEMO_TRADING_ACKNOWLEDGEMENT=
EMERGENCY_STOP=true
AUTOMATIC_ANALYSIS_ENABLED=false
TRADING_SYMBOL=XAUUSD
ACCOUNT_ID=
ACCOUNT_KEY=unconfigured

# Connections and credentials
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-6-astra/u64
DATABASE_URL=
DASHBOARD_CONTROL_TOKEN=

# Optional monitoring credentials
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
