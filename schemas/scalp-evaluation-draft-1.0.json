{
  "$defs": {
    "DraftCandidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9._-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "codeSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Codesha256",
          "type": "string"
        },
        "changedRule": {
          "const": "ENTRY_ONLY",
          "title": "Changedrule",
          "type": "string"
        },
        "hypothesis": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        }
      },
      "required": ["id", "codeSha256", "changedRule", "hypothesis"],
      "title": "DraftCandidate",
      "type": "object"
    },
    "EvaluationPeriod": {
      "additionalProperties": false,
      "properties": {
        "partition": {
          "enum": ["DEVELOPMENT", "VALIDATION", "HOLDOUT"],
          "title": "Partition",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "until": {
          "title": "Until",
          "type": "string"
        }
      },
      "required": ["partition", "start", "until"],
      "title": "EvaluationPeriod",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "scalp-evaluation-draft-1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "status": {
      "const": "DRAFT_NOT_REGISTERED",
      "title": "Status",
      "type": "string"
    },
    "sourceSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourcesha256",
      "type": "string"
    },
    "periods": {
      "items": {
        "$ref": "#/$defs/EvaluationPeriod"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Periods",
      "type": "array"
    },
    "purgeSeconds": {
      "maximum": 1209600,
      "minimum": 0,
      "title": "Purgeseconds",
      "type": "integer"
    },
    "embargoSeconds": {
      "maximum": 1209600,
      "minimum": 0,
      "title": "Embargoseconds",
      "type": "integer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/DraftCandidate"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Candidates",
      "type": "array"
    },
    "declaredAttemptIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Declaredattemptids",
      "type": "array"
    },
    "primaryMetric": {
      "const": "AFTER_COST_EXPECTANCY_WHEN_IDENTIFIABLE",
      "title": "Primarymetric",
      "type": "string"
    },
    "uncertainty": {
      "const": "CORRELATED_CONTEXT_BLOCKS_REQUIRES_REVIEW",
      "title": "Uncertainty",
      "type": "string"
    },
    "multipleTesting": {
      "const": "ALL_DECLARED_ATTEMPTS_REQUIRES_REVIEW",
      "title": "Multipletesting",
      "type": "string"
    },
    "numericalThresholds": {
      "title": "Numericalthresholds",
      "type": "null"
    },
    "operatorThresholdReview": {
      "const": "PENDING",
      "title": "Operatorthresholdreview",
      "type": "string"
    },
    "registrationAuthority": {
      "const": false,
      "title": "Registrationauthority",
      "type": "boolean"
    },
    "promotionAuthority": {
      "const": false,
      "title": "Promotionauthority",
      "type": "boolean"
    },
    "brokerAuthority": {
      "const": false,
      "title": "Brokerauthority",
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sourceSha256",
    "periods",
    "purgeSeconds",
    "embargoSeconds",
    "candidates",
    "declaredAttemptIds",
    "primaryMetric",
    "uncertainty",
    "multipleTesting",
    "numericalThresholds",
    "operatorThresholdReview",
    "registrationAuthority",
    "promotionAuthority",
    "brokerAuthority"
  ],
  "title": "EvaluationDraft",
  "type": "object"
}
