{
  "$defs": {
    "PublisherHealth": {
      "additionalProperties": false,
      "properties": {
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "status": {
          "enum": [
            "DISABLED",
            "BLOCKED",
            "DRAFT",
            "AWAITING_REVIEW",
            "CHECKING",
            "MERGED",
            "IDLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "pattern": "^[A-Z_]{1,100}$",
          "title": "Reason",
          "type": "string"
        },
        "pullRequest": {
          "anyOf": [
            {
              "maximum": 999999999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pullrequest"
        },
        "headCommit": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Headcommit"
        }
      },
      "required": [
        "checkedAt",
        "status",
        "reason",
        "pullRequest",
        "headCommit"
      ],
      "title": "PublisherHealth",
      "type": "object"
    },
    "ResearchHealth": {
      "additionalProperties": false,
      "properties": {
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Stage"
        },
        "experiments": {
          "$ref": "#/$defs/Stage"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Question"
        },
        "planId": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planid"
        },
        "trialId": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trialid"
        },
        "closureCounts": {
          "anyOf": [
            {
              "additionalProperties": {
                "maximum": 4000,
                "minimum": 0,
                "type": "integer"
              },
              "propertyNames": {
                "enum": [
                  "POSITIVE",
                  "NEGATIVE",
                  "INCONCLUSIVE",
                  "REJECTED",
                  "FAILED",
                  "OPEN",
                  "GAP"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closurecounts"
        }
      },
      "required": [
        "checkedAt",
        "observation",
        "experiments",
        "question",
        "planId",
        "trialId",
        "closureCounts"
      ],
      "title": "ResearchHealth",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "Demo",
            "Flight recorder",
            "Observation",
            "Experiments",
            "Publishing"
          ],
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": ["CURRENT", "WAITING", "BLOCKED", "STALE", "UNAVAILABLE"],
          "title": "State",
          "type": "string"
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checkedat"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expiresat"
        },
        "detail": {
          "maxLength": 700,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": ["name", "state", "checkedAt", "expiresAt", "detail"],
      "title": "Stage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "harness-health-1.0",
      "title": "Version",
      "type": "string"
    },
    "checkedAt": {
      "title": "Checkedat",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Stages",
      "type": "array"
    },
    "research": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchHealth"
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublisherHealth"
        },
        {
          "type": "null"
        }
      ]
    },
    "brokerAuthority": {
      "const": false,
      "title": "Brokerauthority",
      "type": "boolean"
    },
    "recoveryAuthority": {
      "const": false,
      "title": "Recoveryauthority",
      "type": "boolean"
    },
    "promotionAuthority": {
      "const": false,
      "title": "Promotionauthority",
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "checkedAt",
    "stages",
    "research",
    "publisher",
    "brokerAuthority",
    "recoveryAuthority",
    "promotionAuthority"
  ],
  "title": "HarnessHealth",
  "type": "object"
}
