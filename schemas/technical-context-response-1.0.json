{
  "$defs": {
    "ContextEvidence": {
      "additionalProperties": false,
      "properties": {
        "definitions_version": {
          "const": "causal-smc-1.0",
          "default": "causal-smc-1.0",
          "title": "Definitions Version",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FrameContext"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Frames",
          "type": "array"
        },
        "depth": {
          "$ref": "#/$defs/DepthContext"
        },
        "spread_to_m1_atr": {
          "title": "Spread To M1 Atr",
          "type": "string"
        },
        "history_targets_met": {
          "title": "History Targets Met",
          "type": "boolean"
        },
        "news": {
          "const": "NOT_COLLECTED",
          "default": "NOT_COLLECTED",
          "title": "News",
          "type": "string"
        },
        "harmonics": {
          "const": "NOT_IMPLEMENTED",
          "default": "NOT_IMPLEMENTED",
          "title": "Harmonics",
          "type": "string"
        },
        "counterfactual_costs": {
          "default": null,
          "title": "Counterfactual Costs",
          "type": "null"
        }
      },
      "required": [
        "frames",
        "depth",
        "spread_to_m1_atr",
        "history_targets_met"
      ],
      "title": "ContextEvidence",
      "type": "object"
    },
    "DayRange": {
      "additionalProperties": false,
      "properties": {
        "utc_date": {
          "title": "Utc Date",
          "type": "string"
        },
        "status": {
          "enum": ["COMPLETE_UTC_DAY", "PARTIAL_OR_UNAVAILABLE"],
          "title": "Status",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        }
      },
      "required": ["utc_date", "status", "high", "low"],
      "title": "DayRange",
      "type": "object"
    },
    "DepthContext": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "BROKER_ONLY_NOT_GLOBAL_ORDER_FLOW",
          "default": "BROKER_ONLY_NOT_GLOBAL_ORDER_FLOW",
          "title": "Scope",
          "type": "string"
        },
        "timestamp_basis": {
          "const": "BROKER_SPOT_CLOCK_AND_LOCAL_RECEIPT",
          "default": "BROKER_SPOT_CLOCK_AND_LOCAL_RECEIPT",
          "title": "Timestamp Basis",
          "type": "string"
        },
        "source_at": {
          "title": "Source At",
          "type": "string"
        },
        "received_at": {
          "title": "Received At",
          "type": "string"
        },
        "bid_levels": {
          "title": "Bid Levels",
          "type": "integer"
        },
        "ask_levels": {
          "title": "Ask Levels",
          "type": "integer"
        },
        "symmetric_sizes": {
          "title": "Symmetric Sizes",
          "type": "boolean"
        },
        "spread": {
          "title": "Spread",
          "type": "string"
        },
        "imbalance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Imbalance"
        },
        "microprice_bias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Microprice Bias"
        },
        "bid_liquidity_change_60s": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bid Liquidity Change 60S"
        },
        "ask_liquidity_change_60s": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ask Liquidity Change 60S"
        },
        "rolling_sample_count_60s": {
          "title": "Rolling Sample Count 60S",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source_at",
        "received_at",
        "bid_levels",
        "ask_levels",
        "symmetric_sizes",
        "spread",
        "imbalance",
        "microprice_bias",
        "bid_liquidity_change_60s",
        "ask_liquidity_change_60s",
        "rolling_sample_count_60s",
        "warnings"
      ],
      "title": "DepthContext",
      "type": "object"
    },
    "FrameContext": {
      "additionalProperties": false,
      "properties": {
        "timeframe": {
          "enum": ["M1", "M5", "M15"],
          "title": "Timeframe",
          "type": "string"
        },
        "candle_count": {
          "title": "Candle Count",
          "type": "integer"
        },
        "latest_completed_at": {
          "title": "Latest Completed At",
          "type": "string"
        },
        "segment_candle_count": {
          "title": "Segment Candle Count",
          "type": "integer"
        },
        "bias": {
          "enum": ["UNKNOWN", "BULLISH", "BEARISH"],
          "title": "Bias",
          "type": "string"
        },
        "atr": {
          "title": "Atr",
          "type": "string"
        },
        "ema_fast": {
          "title": "Ema Fast",
          "type": "string"
        },
        "ema_slow": {
          "title": "Ema Slow",
          "type": "string"
        },
        "rsi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rsi"
        },
        "adx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adx"
        },
        "pivots": {
          "items": {
            "$ref": "#/$defs/Pivot"
          },
          "maxItems": 12,
          "title": "Pivots",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/StructureEvent"
          },
          "maxItems": 12,
          "title": "Events",
          "type": "array"
        },
        "nearest_active_zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "maxItems": 8,
          "title": "Nearest Active Zones",
          "type": "array"
        },
        "recent_resolved_zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "maxItems": 4,
          "title": "Recent Resolved Zones",
          "type": "array"
        },
        "liquidity_pools": {
          "items": {
            "$ref": "#/$defs/LiquidityPool"
          },
          "maxItems": 6,
          "title": "Liquidity Pools",
          "type": "array"
        },
        "active_zone_count": {
          "title": "Active Zone Count",
          "type": "integer"
        },
        "resolved_zone_count": {
          "title": "Resolved Zone Count",
          "type": "integer"
        },
        "previous_utc_day": {
          "$ref": "#/$defs/DayRange"
        }
      },
      "required": [
        "timeframe",
        "candle_count",
        "latest_completed_at",
        "segment_candle_count",
        "bias",
        "atr",
        "ema_fast",
        "ema_slow",
        "rsi",
        "adx",
        "pivots",
        "events",
        "nearest_active_zones",
        "recent_resolved_zones",
        "liquidity_pools",
        "active_zone_count",
        "resolved_zone_count",
        "previous_utc_day"
      ],
      "title": "FrameContext",
      "type": "object"
    },
    "LiquidityPool": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "HISTORICAL_PIVOT_CLUSTER_NOT_RESTING_ORDERS",
          "default": "HISTORICAL_PIVOT_CLUSTER_NOT_RESTING_ORDERS",
          "title": "Scope",
          "type": "string"
        },
        "kind": {
          "enum": ["EQUAL_HIGHS", "EQUAL_LOWS"],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "tolerance": {
          "title": "Tolerance",
          "type": "string"
        },
        "confirmed_touches": {
          "title": "Confirmed Touches",
          "type": "integer"
        },
        "first_pivot_at": {
          "title": "First Pivot At",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "level",
        "tolerance",
        "confirmed_touches",
        "first_pivot_at",
        "available_at"
      ],
      "title": "LiquidityPool",
      "type": "object"
    },
    "Pivot": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": ["HIGH", "LOW"],
          "title": "Side",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "string"
        },
        "candle_at": {
          "title": "Candle At",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        }
      },
      "required": ["side", "price", "candle_at", "available_at"],
      "title": "Pivot",
      "type": "object"
    },
    "StructureEvent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["INITIAL_BREAK", "BOS", "MSS", "SWEEP"],
          "title": "Kind",
          "type": "string"
        },
        "direction": {
          "enum": ["BULLISH", "BEARISH"],
          "title": "Direction",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "pivot_at": {
          "title": "Pivot At",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        },
        "displacement": {
          "title": "Displacement",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "direction",
        "level",
        "pivot_at",
        "available_at",
        "displacement"
      ],
      "title": "StructureEvent",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["ORDER_BLOCK", "FVG"],
          "title": "Kind",
          "type": "string"
        },
        "direction": {
          "enum": ["BULLISH", "BEARISH"],
          "title": "Direction",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "string"
        },
        "origin_at": {
          "title": "Origin At",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        },
        "status": {
          "enum": ["FRESH", "TOUCHED", "FILLED", "INVALIDATED"],
          "title": "Status",
          "type": "string"
        },
        "first_touched_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Touched At"
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved At"
        },
        "age_bars": {
          "title": "Age Bars",
          "type": "integer"
        },
        "distance_from_quote": {
          "title": "Distance From Quote",
          "type": "string"
        },
        "overlap_count": {
          "default": 0,
          "title": "Overlap Count",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "direction",
        "lower",
        "upper",
        "origin_at",
        "available_at",
        "status",
        "first_touched_at",
        "resolved_at",
        "age_bars",
        "distance_from_quote"
      ],
      "title": "Zone",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "technical-context-response-1.0",
      "default": "technical-context-response-1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "analysisId": {
      "format": "uuid",
      "title": "Analysisid",
      "type": "string"
    },
    "inputSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inputsha256",
      "type": "string"
    },
    "capturedAt": {
      "format": "date-time",
      "title": "Capturedat",
      "type": "string"
    },
    "executionAuthority": {
      "const": false,
      "default": false,
      "title": "Executionauthority",
      "type": "boolean"
    },
    "acceptable": {
      "title": "Acceptable",
      "type": "boolean"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Reasons",
      "type": "array"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "codexPayload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Codexpayload"
    }
  },
  "required": [
    "requestId",
    "analysisId",
    "inputSha256",
    "capturedAt",
    "acceptable",
    "reasons",
    "evidence",
    "codexPayload"
  ],
  "title": "ContextResponse",
  "type": "object"
}
