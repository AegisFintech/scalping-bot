{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry-direction-provider-1.0",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": ["BUY", "SELL", "WAIT"],
      "title": "Decision",
      "type": "string"
    },
    "reason": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "upper_breakout": {
      "anyOf": [
        {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Upper Breakout"
    },
    "lower_breakout": {
      "anyOf": [
        {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lower Breakout"
    }
  },
  "required": ["decision", "reason", "upper_breakout", "lower_breakout"],
  "title": "DirectionalDecision",
  "type": "object"
}
