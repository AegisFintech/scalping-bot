{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry-wait-context-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "symbol",
    "captured_at",
    "valid_until",
    "observed_m1_end",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "entry-wait-1.0"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "const": "XAUUSD"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "observed_m1_end": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    }
  }
}
