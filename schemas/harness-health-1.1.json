{
  "$defs": {
    "DeliveryHealth": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "research-delivery-health-1.0",
          "title": "Version",
          "type": "string"
        },
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "brokerAuthority": {
          "const": false,
          "title": "Brokerauthority",
          "type": "boolean"
        },
        "promotionAuthority": {
          "const": false,
          "title": "Promotionauthority",
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "checkedAt",
        "generation",
        "review",
        "brokerAuthority",
        "promotionAuthority"
      ],
      "title": "DeliveryHealth",
      "type": "object"
    },
    "GenerationHealth": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "research-generation-health-1.0",
          "title": "Version",
          "type": "string"
        },
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "status": {
          "pattern": "^[A-Z_]{1,100}$",
          "title": "Status",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "pattern": "^[A-Z_]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phase"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[A-Z_]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "job": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Job"
        },
        "baseCommit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Basecommit"
        },
        "publicationSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publicationsha256"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "brokerAuthority": {
          "const": false,
          "title": "Brokerauthority",
          "type": "boolean"
        },
        "promotionAuthority": {
          "const": false,
          "title": "Promotionauthority",
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "checkedAt",
        "status",
        "phase",
        "reason",
        "job",
        "baseCommit",
        "publicationSha256",
        "origin",
        "brokerAuthority",
        "promotionAuthority"
      ],
      "title": "GenerationHealth",
      "type": "object"
    },
    "HarnessHealth": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "harness-health-1.0",
          "title": "Version",
          "type": "string"
        },
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Stages",
          "type": "array"
        },
        "research": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublisherHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "brokerAuthority": {
          "const": false,
          "title": "Brokerauthority",
          "type": "boolean"
        },
        "recoveryAuthority": {
          "const": false,
          "title": "Recoveryauthority",
          "type": "boolean"
        },
        "promotionAuthority": {
          "const": false,
          "title": "Promotionauthority",
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "checkedAt",
        "stages",
        "research",
        "publisher",
        "brokerAuthority",
        "recoveryAuthority",
        "promotionAuthority"
      ],
      "title": "HarnessHealth",
      "type": "object"
    },
    "Origin": {
      "additionalProperties": false,
      "properties": {
        "trialId": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trialid",
          "type": "string"
        },
        "resultSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resultsha256",
          "type": "string"
        },
        "findingSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Findingsha256",
          "type": "string"
        },
        "question": {
          "maxLength": 600,
          "title": "Question",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "until": {
          "title": "Until",
          "type": "string"
        },
        "recordedClosedRows": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Recordedclosedrows",
          "type": "integer"
        }
      },
      "required": [
        "trialId",
        "resultSha256",
        "findingSha256",
        "question",
        "start",
        "until",
        "recordedClosedRows"
      ],
      "title": "Origin",
      "type": "object"
    },
    "PublisherHealth": {
      "additionalProperties": false,
      "properties": {
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "status": {
          "enum": [
            "DISABLED",
            "BLOCKED",
            "DRAFT",
            "AWAITING_REVIEW",
            "CHECKING",
            "MERGED",
            "IDLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "pattern": "^[A-Z_]{1,100}$",
          "title": "Reason",
          "type": "string"
        },
        "pullRequest": {
          "anyOf": [
            {
              "maximum": 999999999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pullrequest"
        },
        "headCommit": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Headcommit"
        }
      },
      "required": [
        "checkedAt",
        "status",
        "reason",
        "pullRequest",
        "headCommit"
      ],
      "title": "PublisherHealth",
      "type": "object"
    },
    "ResearchHealth": {
      "additionalProperties": false,
      "properties": {
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Stage"
        },
        "experiments": {
          "$ref": "#/$defs/Stage"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Question"
        },
        "planId": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planid"
        },
        "trialId": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trialid"
        },
        "closureCounts": {
          "anyOf": [
            {
              "additionalProperties": {
                "maximum": 4000,
                "minimum": 0,
                "type": "integer"
              },
              "propertyNames": {
                "enum": [
                  "POSITIVE",
                  "NEGATIVE",
                  "INCONCLUSIVE",
                  "REJECTED",
                  "FAILED",
                  "OPEN",
                  "GAP"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closurecounts"
        }
      },
      "required": [
        "checkedAt",
        "observation",
        "experiments",
        "question",
        "planId",
        "trialId",
        "closureCounts"
      ],
      "title": "ResearchHealth",
      "type": "object"
    },
    "ReviewHealth": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "research-review-health-1.0",
          "title": "Version",
          "type": "string"
        },
        "checkedAt": {
          "title": "Checkedat",
          "type": "string"
        },
        "status": {
          "pattern": "^[A-Z_]{1,100}$",
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[A-Z_]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "recent": {
          "items": {
            "$ref": "#/$defs/ReviewOutcome"
          },
          "maxItems": 4,
          "title": "Recent",
          "type": "array"
        },
        "lastTerminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "brokerAuthority": {
          "const": false,
          "title": "Brokerauthority",
          "type": "boolean"
        },
        "promotionAuthority": {
          "const": false,
          "title": "Promotionauthority",
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "checkedAt",
        "status",
        "reason",
        "recent",
        "lastTerminal",
        "brokerAuthority",
        "promotionAuthority"
      ],
      "title": "ReviewHealth",
      "type": "object"
    },
    "ReviewOutcome": {
      "additionalProperties": false,
      "properties": {
        "pullRequest": {
          "maximum": 999999999,
          "minimum": 1,
          "title": "Pullrequest",
          "type": "integer"
        },
        "status": {
          "pattern": "^[A-Z_]{1,100}$",
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[A-Z_]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "publicationSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publicationsha256"
        },
        "headCommit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headcommit"
        },
        "mergeCommit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mergecommit"
        }
      },
      "required": ["pullRequest", "status"],
      "title": "ReviewOutcome",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "Demo",
            "Flight recorder",
            "Observation",
            "Experiments",
            "Publishing"
          ],
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": ["CURRENT", "WAITING", "BLOCKED", "STALE", "UNAVAILABLE"],
          "title": "State",
          "type": "string"
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checkedat"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expiresat"
        },
        "detail": {
          "maxLength": 700,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": ["name", "state", "checkedAt", "expiresAt", "detail"],
      "title": "Stage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "harness-health-1.1",
      "title": "Version",
      "type": "string"
    },
    "checkedAt": {
      "title": "Checkedat",
      "type": "string"
    },
    "core": {
      "$ref": "#/$defs/HarnessHealth"
    },
    "delivery": {
      "$ref": "#/$defs/DeliveryHealth"
    }
  },
  "required": ["version", "checkedAt", "core", "delivery"],
  "title": "HarnessEnvelope11",
  "type": "object"
}
