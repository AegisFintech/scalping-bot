{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ctrader-ai-scalper.invalid/schemas/entry-retirement-1.0.json",
  "title": "Proven unusable, never-submitted entry pair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "reasonCodes",
    "observedAt",
    "quote",
    "tickSize",
    "minimumEntryDistance",
    "buyStop",
    "sellStop"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "phase": {
      "enum": ["PROVIDER_RETURN", "LOCAL_REUSE", "POST_MODEL", "PRE_PLACEMENT"]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["BUY_ENTRY_TOO_CLOSE", "SELL_ENTRY_TOO_CLOSE"]
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bid", "ask", "sourceTime", "receivedAt"],
      "properties": {
        "bid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "ask": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "sourceTime": {
          "type": "string",
          "format": "date-time"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tickSize": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
    },
    "minimumEntryDistance": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
    },
    "buyStop": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
    },
    "sellStop": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
    }
  }
}
