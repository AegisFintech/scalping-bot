{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ctrader-ai-scalper.invalid/schemas/scenario-plan-1.0.json",
  "title": "Chart scenarios with no execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "symbol",
    "captured_at",
    "valid_until",
    "decision_zone",
    "rebound_resistance",
    "recovery_above",
    "bearish_below",
    "extension_below",
    "recovery_targets",
    "extension_targets",
    "broader_resistance"
  ],
  "properties": {
    "schema_version": {
      "const": "scenario-1.0",
      "type": "string"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9._-]{1,32}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "decision_zone": {
      "$ref": "#/$defs/zone"
    },
    "rebound_resistance": {
      "$ref": "#/$defs/zone"
    },
    "recovery_above": {
      "$ref": "#/$defs/decimal"
    },
    "bearish_below": {
      "$ref": "#/$defs/decimal"
    },
    "extension_below": {
      "$ref": "#/$defs/decimal"
    },
    "recovery_targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/decimal"
      }
    },
    "extension_targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/decimal"
      }
    },
    "broader_resistance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/zone"
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$",
      "maxLength": 27
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {
          "$ref": "#/$defs/decimal"
        },
        "upper": {
          "$ref": "#/$defs/decimal"
        }
      }
    }
  }
}
