{
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "broker-metadata-observation-1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "symbol": {
      "pattern": "^[A-Z0-9._-]{1,32}$",
      "title": "Symbol",
      "type": "string"
    },
    "requestStartedAt": {
      "title": "Requeststartedat",
      "type": "string"
    },
    "responseReceivedAt": {
      "title": "Responsereceivedat",
      "type": "string"
    },
    "brokerSourceTime": {
      "title": "Brokersourcetime",
      "type": "null"
    },
    "adapterMetadataAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Adaptermetadataat"
    },
    "reportedSymbol": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9._-]{1,32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reportedsymbol"
    },
    "provenance": {
      "const": "BROKER_METADATA_ENDPOINT_RESPONSE_NOT_ORIGINAL_ACK",
      "title": "Provenance",
      "type": "string"
    },
    "actualClosingCosts": {
      "title": "Actualclosingcosts",
      "type": "null"
    },
    "terms": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 32,
            "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Terms",
      "type": "object"
    },
    "categories": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Categories",
      "type": "object"
    },
    "unavailableFields": {
      "items": {
        "type": "string"
      },
      "title": "Unavailablefields",
      "type": "array"
    },
    "evidenceSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidencesha256",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "symbol",
    "requestStartedAt",
    "responseReceivedAt",
    "brokerSourceTime",
    "adapterMetadataAt",
    "reportedSymbol",
    "provenance",
    "actualClosingCosts",
    "terms",
    "categories",
    "unavailableFields",
    "evidenceSha256"
  ],
  "title": "MetadataObservation",
  "type": "object"
}
