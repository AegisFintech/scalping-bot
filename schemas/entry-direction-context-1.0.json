{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry-direction-context-1.0",
  "title": "Locally bound stop-entry context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "symbol",
    "captured_at",
    "valid_until",
    "buy_stop",
    "sell_stop",
    "entry_side",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "entry-direction-1.0"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9._-]{1,32}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "buy_stop": {
      "$ref": "#/$defs/price"
    },
    "sell_stop": {
      "$ref": "#/$defs/price"
    },
    "entry_side": {
      "enum": ["BUY", "SELL"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    }
  },
  "$defs": {
    "price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
    }
  }
}
