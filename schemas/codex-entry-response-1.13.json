{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-entry-response-1.13",
  "$defs": {
    "ScalpDecisionV2": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": ["BUY", "SELL", "WAIT"],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "entry_price": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entry Price"
        },
        "take_profit": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Take Profit"
        },
        "stop_loss": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stop Loss"
        },
        "pending_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 60,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pending Seconds"
        }
      },
      "required": [
        "decision",
        "reason",
        "entry_price",
        "take_profit",
        "stop_loss",
        "pending_seconds"
      ],
      "title": "ScalpDecisionV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "codex-entry-response-1.13",
      "title": "Version",
      "type": "string"
    },
    "provider": {
      "const": "openai-api",
      "title": "Provider",
      "type": "string"
    },
    "analysisId": {
      "title": "Analysisid",
      "type": "string"
    },
    "requestedModel": {
      "const": "gpt-6.1-sol",
      "title": "Requestedmodel",
      "type": "string"
    },
    "returnedModel": {
      "const": "gpt-6.1-sol",
      "title": "Returnedmodel",
      "type": "string"
    },
    "promptSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Promptsha256",
      "type": "string"
    },
    "capturedAt": {
      "title": "Capturedat",
      "type": "string"
    },
    "receivedAt": {
      "title": "Receivedat",
      "type": "string"
    },
    "entries": {
      "$ref": "#/$defs/ScalpDecisionV2"
    },
    "rawResponse": {
      "maxLength": 8192,
      "title": "Rawresponse",
      "type": "string"
    },
    "inputTokens": {
      "minimum": 0,
      "title": "Inputtokens",
      "type": "integer"
    },
    "outputTokens": {
      "minimum": 0,
      "title": "Outputtokens",
      "type": "integer"
    },
    "costAmount": {
      "title": "Costamount",
      "type": "null"
    },
    "providerRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Providerrequestid",
      "type": "string"
    },
    "contextPolicy": {
      "const": "fresh-input-v1",
      "title": "Contextpolicy",
      "type": "string"
    },
    "executionAuthority": {
      "const": false,
      "title": "Executionauthority",
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "provider",
    "analysisId",
    "requestedModel",
    "returnedModel",
    "promptSha256",
    "capturedAt",
    "receivedAt",
    "entries",
    "rawResponse",
    "inputTokens",
    "outputTokens",
    "costAmount",
    "providerRequestId",
    "contextPolicy",
    "executionAuthority"
  ],
  "title": "ResponseV113",
  "type": "object"
}
