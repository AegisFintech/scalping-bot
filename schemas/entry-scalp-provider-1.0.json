{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry-scalp-provider-1.0",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": ["BUY", "SELL", "WAIT"],
      "title": "Decision",
      "type": "string"
    },
    "reason": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "entry_price": {
      "anyOf": [
        {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entry Price"
    },
    "take_profit": {
      "anyOf": [
        {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Take Profit"
    },
    "stop_loss": {
      "anyOf": [
        {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stop Loss"
    },
    "pending_seconds": {
      "anyOf": [
        {
          "maximum": 300,
          "minimum": 60,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Seconds"
    }
  },
  "required": [
    "decision",
    "reason",
    "entry_price",
    "take_profit",
    "stop_loss",
    "pending_seconds"
  ],
  "title": "ScalpDecision",
  "type": "object"
}
