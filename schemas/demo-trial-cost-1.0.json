{
  "$id": "demo-trial-cost-1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume",
    "target_distance_price",
    "stop_distance_price",
    "modeled_base_target_net_price",
    "modeled_stress_target_net_price",
    "modeled_stress_stop_loss_price",
    "modeled_base_commission_price",
    "modeled_stress_commission_price",
    "base_exit_reserve_price",
    "stress_exit_reserve_price",
    "evidence_version",
    "modeled_break_even_win_fraction",
    "spread_deducted_again",
    "actual_exit_cost",
    "guaranteed_closing_proceeds"
  ],
  "properties": {
    "volume": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "target_distance_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "stop_distance_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "modeled_base_target_net_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "modeled_stress_target_net_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "modeled_stress_stop_loss_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "modeled_base_commission_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "modeled_stress_commission_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "base_exit_reserve_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "stress_exit_reserve_price": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "evidence_version": {
      "const": "demo-trial-cost-1.0"
    },
    "modeled_break_even_win_fraction": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "spread_deducted_again": {
      "const": false
    },
    "actual_exit_cost": {
      "type": "null"
    },
    "guaranteed_closing_proceeds": {
      "const": false
    }
  }
}
