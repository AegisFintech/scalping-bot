        "pip_size": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Pip Size",
          "type": "string"
        },
        "maximum_stop_distance": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Maximum Stop Distance",
          "type": "string"
        },
        "minimum_protection_distance": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Minimum Protection Distance",
          "type": "string"
        }
      },
      "required": [
        "captured_at",
        "tick_size",
        "quote",
        "minimum_entry_distance",
        "entry_boundaries",
        "candles",
        "market_captured_at",
        "technical_context",
        "context_input_sha256",
        "execution_context",
        "pip_size",
        "maximum_stop_distance",
        "minimum_protection_distance"
      ],
      "title": "PayloadScalp",
      "type": "object"
    },
    "Pivot": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": ["HIGH", "LOW"],
          "title": "Side",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "string"
        },
        "candle_at": {
          "title": "Candle At",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        }
      },
      "required": ["side", "price", "candle_at", "available_at"],
      "title": "Pivot",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
