{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-entry-request-1.12",
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "minimum_entry_distance": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Minimum Entry Distance",
          "type": "string"
        },
        "buy_stop_minimum": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Buy Stop Minimum",
          "type": "string"
        },
        "sell_stop_maximum": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Sell Stop Maximum",
          "type": "string"
        },
        "movement_buffer": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Movement Buffer",
          "type": "string"
        },
        "preferred_buy_stop_minimum": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Preferred Buy Stop Minimum",
          "type": "string"
        },
        "preferred_sell_stop_maximum": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Preferred Sell Stop Maximum",
          "type": "string"
        }
      },
      "required": [
        "minimum_entry_distance",
        "buy_stop_minimum",
        "sell_stop_maximum",
        "movement_buffer",
        "preferred_buy_stop_minimum",
        "preferred_sell_stop_maximum"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "CandleAnatomy": {
      "additionalProperties": false,
      "properties": {
        "end_at": {
          "title": "End At",
          "type": "string"
        },
        "direction": {
          "enum": ["UP", "DOWN", "DOJI"],
          "title": "Direction",
          "type": "string"
        },
        "range_size": {
          "title": "Range Size",
          "type": "string"
        },
        "range_to_atr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Range To Atr"
        },
        "body_fraction": {
          "title": "Body Fraction",
          "type": "string"
        },
        "upper_wick_fraction": {
          "title": "Upper Wick Fraction",
          "type": "string"
        },
        "lower_wick_fraction": {
          "title": "Lower Wick Fraction",
          "type": "string"
        },
        "close_location": {
          "title": "Close Location",
          "type": "string"
        },
        "inside_bar": {
          "title": "Inside Bar",
          "type": "boolean"
        },
        "engulfing": {
          "title": "Engulfing",
          "type": "boolean"
        },
        "displacement": {
          "title": "Displacement",
          "type": "boolean"
        }
      },
      "required": [
        "end_at",
        "direction",
        "range_size",
        "range_to_atr",
        "body_fraction",
        "upper_wick_fraction",
        "lower_wick_fraction",
        "close_location",
        "inside_bar",
        "engulfing",
        "displacement"
      ],
      "title": "CandleAnatomy",
      "type": "object"
    },
    "Candles": {
      "additionalProperties": false,
      "properties": {
        "timeframe": {
          "enum": ["M1", "M5", "M15"],
          "title": "Timeframe",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {},
            "type": "array"
          },
          "maxItems": 288,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": ["timeframe", "columns", "rows"],
      "title": "Candles",
      "type": "object"
    },
    "ClosedOutcome": {
      "additionalProperties": false,
      "properties": {
        "closed_at": {
          "title": "Closed At",
          "type": "string"
        },
        "direction": {
          "enum": ["LONG", "SHORT"],
          "title": "Direction",
          "type": "string"
        },
        "realized_net": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
          "title": "Realized Net",
          "type": "string"
        },
        "strategy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "closed_at",
        "direction",
        "realized_net",
        "strategy_version"
      ],
      "title": "ClosedOutcome",
      "type": "object"
    },
    "ContextEvidenceV11": {
      "additionalProperties": false,
      "properties": {
        "definitions_version": {
          "const": "causal-smc-1.1",
          "default": "causal-smc-1.1",
          "title": "Definitions Version",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FrameContextV11"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Frames",
          "type": "array"
        },
        "depth": {
          "$ref": "#/$defs/DepthContext"
        },
        "spread_to_m1_atr": {
          "title": "Spread To M1 Atr",
          "type": "string"
        },
        "history_targets_met": {
          "title": "History Targets Met",
          "type": "boolean"
        },
        "news": {
          "const": "NOT_COLLECTED",
          "default": "NOT_COLLECTED",
          "title": "News",
          "type": "string"
        },
        "harmonics": {
          "const": "NOT_IMPLEMENTED",
          "default": "NOT_IMPLEMENTED",
          "title": "Harmonics",
          "type": "string"
        },
        "counterfactual_costs": {
          "default": null,
          "title": "Counterfactual Costs",
          "type": "null"
        },
        "m1_envelopes": {
          "items": {
            "$ref": "#/$defs/Envelope"
          },
          "maxItems": 4,
          "title": "M1 Envelopes",
          "type": "array"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionRange"
          },
          "maxItems": 6,
          "title": "Sessions",
          "type": "array"
        },
        "round_levels": {
          "items": {
            "$ref": "#/$defs/RoundLevel"
          },
          "maxItems": 4,
          "title": "Round Levels",
          "type": "array"
        }
      },
      "required": [
        "frames",
        "depth",
        "spread_to_m1_atr",
        "history_targets_met",
        "m1_envelopes",
        "sessions",
        "round_levels"
      ],
      "title": "ContextEvidenceV11",
      "type": "object"
    },
    "DayRange": {
      "additionalProperties": false,
      "properties": {
        "utc_date": {
          "title": "Utc Date",
          "type": "string"
        },
        "status": {
          "enum": ["COMPLETE_UTC_DAY", "PARTIAL_OR_UNAVAILABLE"],
          "title": "Status",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        }
      },
      "required": ["utc_date", "status", "high", "low"],
      "title": "DayRange",
      "type": "object"
    },
    "DealingRange": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "LATEST_SWING_LEG_CONFIRMED_PIVOTS",
          "default": "LATEST_SWING_LEG_CONFIRMED_PIVOTS",
          "title": "Basis",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "high_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "High At"
        },
        "low": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        },
        "low_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low At"
        },
        "equilibrium": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equilibrium"
        },
        "position": {
          "enum": [
            "PREMIUM",
            "DISCOUNT",
            "EQUILIBRIUM",
            "ABOVE_RANGE",
            "BELOW_RANGE",
            "UNAVAILABLE"
          ],
          "title": "Position",
          "type": "string"
        },
        "position_fraction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Fraction"
        }
      },
      "required": [
        "high",
        "high_at",
        "low",
        "low_at",
        "equilibrium",
        "position",
        "position_fraction"
      ],
      "title": "DealingRange",
      "type": "object"
    },
    "DepthContext": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "BROKER_ONLY_NOT_GLOBAL_ORDER_FLOW",
          "default": "BROKER_ONLY_NOT_GLOBAL_ORDER_FLOW",
          "title": "Scope",
          "type": "string"
        },
        "timestamp_basis": {
          "const": "BROKER_SPOT_CLOCK_AND_LOCAL_RECEIPT",
          "default": "BROKER_SPOT_CLOCK_AND_LOCAL_RECEIPT",
          "title": "Timestamp Basis",
          "type": "string"
        },
        "source_at": {
          "title": "Source At",
          "type": "string"
        },
        "received_at": {
          "title": "Received At",
          "type": "string"
        },
        "bid_levels": {
          "title": "Bid Levels",
          "type": "integer"
        },
        "ask_levels": {
          "title": "Ask Levels",
          "type": "integer"
        },
        "symmetric_sizes": {
          "title": "Symmetric Sizes",
          "type": "boolean"
        },
        "spread": {
          "title": "Spread",
          "type": "string"
        },
        "imbalance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Imbalance"
        },
        "microprice_bias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Microprice Bias"
        },
        "bid_liquidity_change_60s": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bid Liquidity Change 60S"
        },
        "ask_liquidity_change_60s": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ask Liquidity Change 60S"
        },
        "rolling_sample_count_60s": {
          "title": "Rolling Sample Count 60S",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source_at",
        "received_at",
        "bid_levels",
        "ask_levels",
        "symmetric_sizes",
        "spread",
        "imbalance",
        "microprice_bias",
        "bid_liquidity_change_60s",
        "ask_liquidity_change_60s",
        "rolling_sample_count_60s",
        "warnings"
      ],
      "title": "DepthContext",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "candles": {
          "enum": [3, 5, 10, 20],
          "title": "Candles",
          "type": "integer"
        },
        "high": {
          "title": "High",
          "type": "string"
        },
        "high_at": {
          "title": "High At",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "string"
        },
        "low_at": {
          "title": "Low At",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "string"
        },
        "width_to_atr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Width To Atr"
        }
      },
      "required": [
        "candles",
        "high",
        "high_at",
        "low",
        "low_at",
        "width",
        "width_to_atr"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ExecutionContextV17": {
      "additionalProperties": false,
      "properties": {
        "spread_price": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Spread Price",
          "type": "string"
        },
        "modeled_round_trip_cost_price": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Modeled Round Trip Cost Price",
          "type": "string"
        },
        "cost_basis": {
          "const": "CONSERVATIVE_MIN_VOLUME_RESERVE_EXCLUDES_SPREAD",
          "title": "Cost Basis",
          "type": "string"
        },
        "shared_setup_risk_percent": {
          "const": "5",
          "title": "Shared Setup Risk Percent",
          "type": "string"
        },
        "recent_closed_outcomes": {
          "items": {
            "$ref": "#/$defs/ClosedOutcome"
          },
          "maxItems": 8,
          "title": "Recent Closed Outcomes",
          "type": "array"
        }
      },
      "required": [
        "spread_price",
        "modeled_round_trip_cost_price",
        "cost_basis",
        "shared_setup_risk_percent",
        "recent_closed_outcomes"
      ],
      "title": "ExecutionContextV17",
      "type": "object"
    },
    "FrameContextV11": {
      "additionalProperties": false,
      "properties": {
        "timeframe": {
          "enum": ["M1", "M5", "M15"],
          "title": "Timeframe",
          "type": "string"
        },
        "candle_count": {
          "title": "Candle Count",
          "type": "integer"
        },
        "latest_completed_at": {
          "title": "Latest Completed At",
          "type": "string"
        },
        "segment_candle_count": {
          "title": "Segment Candle Count",
          "type": "integer"
        },
        "bias": {
          "enum": ["UNKNOWN", "BULLISH", "BEARISH"],
          "title": "Bias",
          "type": "string"
        },
        "atr": {
          "title": "Atr",
          "type": "string"
        },
        "ema_fast": {
          "title": "Ema Fast",
          "type": "string"
        },
        "ema_slow": {
          "title": "Ema Slow",
          "type": "string"
        },
        "rsi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rsi"
        },
        "adx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adx"
        },
        "pivots": {
          "items": {
            "$ref": "#/$defs/Pivot"
          },
          "maxItems": 12,
          "title": "Pivots",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/StructureEvent"
          },
          "maxItems": 12,
          "title": "Events",
          "type": "array"
        },
        "nearest_active_zones": {
          "items": {
            "$ref": "#/$defs/ZoneV11"
          },
          "maxItems": 8,
          "title": "Nearest Active Zones",
          "type": "array"
        },
        "recent_resolved_zones": {
          "items": {
            "$ref": "#/$defs/ZoneV11"
          },
          "maxItems": 4,
          "title": "Recent Resolved Zones",
          "type": "array"
        },
        "liquidity_pools": {
          "items": {
            "$ref": "#/$defs/LiquidityPool"
          },
          "maxItems": 6,
          "title": "Liquidity Pools",
          "type": "array"
        },
        "active_zone_count": {
          "title": "Active Zone Count",
          "type": "integer"
        },
        "resolved_zone_count": {
          "title": "Resolved Zone Count",
          "type": "integer"
        },
        "previous_utc_day": {
          "$ref": "#/$defs/DayRange"
        },
        "support_resistance": {
          "items": {
            "$ref": "#/$defs/SupportResistance"
          },
          "maxItems": 6,
          "title": "Support Resistance",
          "type": "array"
        },
        "dealing_range": {
          "$ref": "#/$defs/DealingRange"
        },
        "candle_anatomy": {
          "items": {
            "$ref": "#/$defs/CandleAnatomy"
          },
          "maxItems": 5,
          "title": "Candle Anatomy",
          "type": "array"
        }
      },
      "required": [
        "timeframe",
        "candle_count",
        "latest_completed_at",
        "segment_candle_count",
        "bias",
        "atr",
        "ema_fast",
        "ema_slow",
        "rsi",
        "adx",
        "pivots",
        "events",
        "nearest_active_zones",
        "recent_resolved_zones",
        "liquidity_pools",
        "active_zone_count",
        "resolved_zone_count",
        "previous_utc_day",
        "support_resistance",
        "dealing_range",
        "candle_anatomy"
      ],
      "title": "FrameContextV11",
      "type": "object"
    },
    "LiquidityPool": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "HISTORICAL_PIVOT_CLUSTER_NOT_RESTING_ORDERS",
          "default": "HISTORICAL_PIVOT_CLUSTER_NOT_RESTING_ORDERS",
          "title": "Scope",
          "type": "string"
        },
        "kind": {
          "enum": ["EQUAL_HIGHS", "EQUAL_LOWS"],
