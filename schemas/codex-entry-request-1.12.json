          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "tolerance": {
          "title": "Tolerance",
          "type": "string"
        },
        "confirmed_touches": {
          "title": "Confirmed Touches",
          "type": "integer"
        },
        "first_pivot_at": {
          "title": "First Pivot At",
          "type": "string"
        },
        "available_at": {
          "title": "Available At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "level",
        "tolerance",
        "confirmed_touches",
        "first_pivot_at",
        "available_at"
      ],
      "title": "LiquidityPool",
      "type": "object"
    },
    "PayloadScalp": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "tick_size": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Tick Size",
          "type": "string"
        },
        "quote": {
          "$ref": "#/$defs/Quote"
        },
        "minimum_entry_distance": {
          "maxLength": 24,
          "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,10})?$",
          "title": "Minimum Entry Distance",
          "type": "string"
        },
        "entry_boundaries": {
          "$ref": "#/$defs/Bounds"
        },
        "candles": {
          "items": {
            "$ref": "#/$defs/Candles"
