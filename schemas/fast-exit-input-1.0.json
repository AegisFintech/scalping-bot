{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fast-exit conditional research inputs; no broker authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "release",
    "from",
    "until",
    "cohort",
    "economics",
    "setups"
  ],
  "properties": {
    "label": {
      "const": "FAST_EXIT_INPUT_V1"
    },
    "release": {
      "const": "0.3.0-fade-limit.3-codex.1"
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "cohort": {
      "const": "OBSERVED_DEMO_INTENTS_CONDITIONAL_NOT_STRATEGY_BACKTEST"
    },
    "economics": {
      "type": "null"
    },
    "setups": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/setup"
      }
    }
  },
  "$defs": {
    "time": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "decimal": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{1,20}(\\.[0-9]{1,10})?$"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "captured",
        "available",
        "valid_until",
        "submission_valid_until",
        "tick_size",
        "model_buy",
        "model_sell",
        "model_schema",
        "legs"
      ],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "captured": {
          "$ref": "#/$defs/time"
        },
        "available": {
          "$ref": "#/$defs/time"
        },
        "valid_until": {
          "$ref": "#/$defs/time"
        },
        "submission_valid_until": {
          "$ref": "#/$defs/time"
        },
        "tick_size": {
          "$ref": "#/$defs/decimal"
        },
        "model_buy": {
          "$ref": "#/$defs/decimal"
        },
        "model_sell": {
          "$ref": "#/$defs/decimal"
        },
        "model_schema": {
          "type": ["string", "null"]
        },
        "legs": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/leg"
          }
        }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "accepted",
        "entry",
        "sl",
        "tp",
        "volume",
        "budget",
        "equity",
        "order_type",
        "tif",
        "fill",
        "fill_count",
        "cancelled_at",
        "fee_evidence"
      ],
      "properties": {
        "side": {
          "enum": ["BUY", "SELL"]
        },
        "accepted": {
          "$ref": "#/$defs/time"
        },
        "entry": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(\\.[0-9]{1,10})?$"
        },
        "sl": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(\\.[0-9]{1,10})?$"
        },
        "tp": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(\\.[0-9]{1,10})?$"
        },
        "volume": {
          "type": "string",
          "pattern": "^[0-9]{1,20}(\\.[0-9]{1,10})?$"
        },
        "budget": {
          "$ref": "#/$defs/decimal"
        },
        "equity": {
          "$ref": "#/$defs/decimal"
        },
        "order_type": {
          "type": ["string", "null"]
        },
        "tif": {
          "type": "string"
        },
        "fill": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["time", "price"],
              "properties": {
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "price": {
                  "type": "string",
                  "pattern": "^[0-9]{1,20}(\\.[0-9]{1,10})?$"
                }
              }
            }
          ]
        },
        "fill_count": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled_at": {
          "$ref": "#/$defs/time"
        },
        "fee_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "fees", "gross", "pips", "pip_size", "volume"],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "fees": {
                "$ref": "#/$defs/decimal"
              },
              "gross": {
                "$ref": "#/$defs/decimal"
              },
              "pips": {
                "$ref": "#/$defs/decimal"
              },
              "pip_size": {
                "$ref": "#/$defs/decimal"
              },
              "volume": {
                "$ref": "#/$defs/decimal"
              }
            }
          }
        }
      }
    }
  }
}
