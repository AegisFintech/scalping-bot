{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "symbolId": {
          "type": "string"
        },
        "symbolName": {
          "type": "string"
        },
        "digits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pipPosition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pipSize": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "tickSize": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "tickValue": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "baseAsset": {
          "type": "string",
          "pattern": "^[A-Z0-9._-]{2,16}$"
        },
        "quoteAsset": {
          "type": "string",
          "pattern": "^[A-Z0-9._-]{2,16}$"
        },
        "accountAsset": {
          "type": "string",
          "pattern": "^[A-Z0-9._-]{2,16}$"
        },
        "quoteToAccountConversionRate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "contractSize": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "volumeScale": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "minVolume": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "maxVolume": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "volumeStep": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "minStopDistance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
        },
        "commission": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "USD_PER_MILLION_USD",
                "USD_PER_LOT",
                "PERCENTAGE_OF_VALUE",
                "QUOTE_CCY_PER_LOT"
              ]
            },
            "rate": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
            },
            "minimum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
            },
            "minimumType": {
              "type": "string",
              "enum": ["CURRENCY", "QUOTE_CURRENCY"]
            },
            "minimumAsset": {
              "type": "string",
              "pattern": "^[A-Z0-9._-]{2,16}$"
            },
            "pnlConversionFeeRate": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,10})?$"
            }
          },
          "required": [
            "type",
            "rate",
            "minimum",
            "minimumType",
            "minimumAsset",
            "pnlConversionFeeRate"
          ],
          "additionalProperties": false
        },
        "metadataTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "symbolId",
        "symbolName",
        "digits",
        "pipPosition",
        "pipSize",
        "tickSize",
        "tickValue",
        "baseAsset",
        "quoteAsset",
        "accountAsset",
        "quoteToAccountConversionRate",
        "contractSize",
        "volumeScale",
        "minVolume",
        "maxVolume",
        "volumeStep",
        "minStopDistance",
        "commission",
        "metadataTime"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "intervals": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSecond": {
                "type": "integer",
                "minimum": 0,
                "maximum": 604799
              },
              "endSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 604800
              }
            },
            "required": ["startSecond", "endSecond"],
            "additionalProperties": false
          }
        },
        "holidays": {
          "maxItems": 366,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSecond": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86399
              },
              "endSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "holidayDate": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "isRecurring": {
                "type": "boolean"
              },
              "timeZone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "startSecond",
              "endSecond",
              "holidayDate",
              "isRecurring",
              "timeZone"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["timeZone", "intervals", "holidays"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "metadata", "schedule"],
  "additionalProperties": false,
  "title": "Broker market session and metadata 1.0"
}
