{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification-report-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qualificationVersion",
    "qualified",
    "sourceSha256",
    "nodeSha256",
    "pythonSha256",
    "nodeVersion",
    "results"
  ],
  "properties": {
    "qualificationVersion": { "const": "1.0" },
    "qualified": { "type": "boolean" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pythonSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodeVersion": { "type": "string", "pattern": "^v22\\." },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "executable", "args", "code", "elapsedMs"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "executable": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "code": { "type": "integer" },
          "elapsedMs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
