{
  "$defs": {
    "Day": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "since": {
          "title": "Since",
          "type": "string"
        },
        "until": {
          "title": "Until",
          "type": "string"
        },
        "completeCalendarDay": {
          "title": "Completecalendarday",
          "type": "boolean"
        },
        "recordedNet": {
          "maxLength": 32,
          "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
          "title": "Recordednet",
          "type": "string"
        },
        "signedFeesIncluded": {
          "maxLength": 32,
          "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
          "title": "Signedfeesincluded",
          "type": "string"
        },
        "closeDeals": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Closedeals",
          "type": "integer"
        },
        "winningCloseDeals": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Winningclosedeals",
          "type": "integer"
        },
        "losingCloseDeals": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Losingclosedeals",
          "type": "integer"
        },
        "flatCloseDeals": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Flatclosedeals",
          "type": "integer"
        },
        "averageWinningCloseDeal": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Averagewinningclosedeal"
        },
        "averageLosingCloseDeal": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Averagelosingclosedeal"
        },
        "worstCloseDeal": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Worstclosedeal"
        }
      },
      "required": [
        "day",
        "since",
        "until",
        "completeCalendarDay",
        "recordedNet",
        "signedFeesIncluded",
        "closeDeals",
        "winningCloseDeals",
        "losingCloseDeals",
        "flatCloseDeals",
        "averageWinningCloseDeal",
        "averageLosingCloseDeal",
        "worstCloseDeal"
      ],
      "title": "Day",
      "type": "object"
    },
    "TrialOutcomes": {
      "additionalProperties": false,
      "properties": {
        "trialId": {
          "pattern": "^[a-f0-9-]{36}$",
          "title": "Trialid",
          "type": "string"
        },
        "profileId": {
          "title": "Profileid",
          "type": "string"
        },
        "profileSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profilesha256",
          "type": "string"
        },
        "sourceSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sourcesha256",
          "type": "string"
        },
        "state": {
          "enum": ["ACTIVE", "DRAINING", "COMPLETED"],
          "title": "State",
          "type": "string"
        },
        "proposals": {
          "minimum": 0,
          "title": "Proposals",
          "type": "integer"
        },
        "providerClaims": {
          "minimum": 0,
          "title": "Providerclaims",
          "type": "integer"
        },
        "waits": {
          "minimum": 0,
          "title": "Waits",
          "type": "integer"
        },
        "failedProposals": {
          "minimum": 0,
          "title": "Failedproposals",
          "type": "integer"
        },
        "incompleteContexts": {
          "minimum": 0,
          "title": "Incompletecontexts",
          "type": "integer"
        },
        "groups": {
          "minimum": 0,
          "title": "Groups",
          "type": "integer"
        },
        "provenZeroFillGroups": {
          "minimum": 0,
          "title": "Provenzerofillgroups",
          "type": "integer"
        },
        "provenUnsentGroups": {
          "minimum": 0,
          "title": "Provenunsentgroups",
          "type": "integer"
        },
        "provenClosedGroups": {
          "minimum": 0,
          "title": "Provenclosedgroups",
          "type": "integer"
        },
        "unprovenGroups": {
          "minimum": 0,
          "title": "Unprovengroups",
          "type": "integer"
        }
      },
      "required": [
        "trialId",
        "profileId",
        "profileSha256",
        "sourceSha256",
        "state",
        "proposals",
        "providerClaims",
        "waits",
        "failedProposals",
        "incompleteContexts",
        "groups",
        "provenZeroFillGroups",
        "provenUnsentGroups",
        "provenClosedGroups",
        "unprovenGroups"
      ],
      "title": "TrialOutcomes",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "demo-day-scorecard-1.1",
      "default": "demo-day-scorecard-1.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "checkedAt": {
      "title": "Checkedat",
      "type": "string"
    },
    "since": {
      "title": "Since",
      "type": "string"
    },
    "until": {
      "title": "Until",
      "type": "string"
    },
    "timezone": {
      "const": "Asia/Singapore",
      "default": "Asia/Singapore",
      "title": "Timezone",
      "type": "string"
    },
    "release": {
      "const": "0.11.0-trend-retest.1-codex.1",
      "default": "0.11.0-trend-retest.1-codex.1",
      "title": "Release",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3,8}$",
      "title": "Currency",
      "type": "string"
    },
    "basis": {
      "const": "RECORDED_CLOSE_DEALS_NOT_ACCOUNT_RETURN",
      "default": "RECORDED_CLOSE_DEALS_NOT_ACCOUNT_RETURN",
      "title": "Basis",
      "type": "string"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/Day"
      },
      "maxItems": 7,
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "trialOutcomes": {
      "items": {
        "$ref": "#/$defs/TrialOutcomes"
      },
      "maxItems": 26,
      "title": "Trialoutcomes",
      "type": "array"
    },
    "trialOutcomesReadState": {
      "default": "unavailable",
      "enum": ["ready", "unavailable"],
      "title": "Trialoutcomesreadstate",
      "type": "string"
    },
    "recordedNet": {
      "maxLength": 32,
      "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
      "title": "Recordednet",
      "type": "string"
    },
    "realizedLedgerDrawdownLowerBound": {
      "maxLength": 32,
      "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,10})?$",
      "title": "Realizedledgerdrawdownlowerbound",
      "type": "string"
    },
    "completePositiveDays": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completepositivedays"
    },
    "completeNegativeDays": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completenegativedays"
    },
    "completeFlatDays": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completeflatdays"
    },
    "scopeUnresolvedEvents": {
      "minimum": 0,
      "title": "Scopeunresolvedevents",
      "type": "integer"
    },
    "openJournalPositions": {
      "minimum": 0,
      "title": "Openjournalpositions",
      "type": "integer"
    },
    "externalCashflows": {
      "default": null,
      "title": "Externalcashflows",
      "type": "null"
    },
    "openBrokerMark": {
      "default": null,
      "title": "Openbrokermark",
      "type": "null"
    },
    "actualModelSpend": {
      "default": null,
      "title": "Actualmodelspend",
      "type": "null"
    },
    "accountReturn": {
      "default": null,
      "title": "Accountreturn",
      "type": "null"
    },
    "equityDrawdown": {
      "default": null,
      "title": "Equitydrawdown",
      "type": "null"
    },
    "economicQualification": {
      "const": false,
      "default": false,
      "title": "Economicqualification",
      "type": "boolean"
    },
    "brokerAuthority": {
      "const": false,
      "default": false,
      "title": "Brokerauthority",
      "type": "boolean"
    },
    "promotionAuthority": {
      "const": false,
      "default": false,
      "title": "Promotionauthority",
      "type": "boolean"
    }
  },
  "required": [
    "checkedAt",
    "since",
    "until",
    "currency",
    "days",
    "trialOutcomes",
    "recordedNet",
    "realizedLedgerDrawdownLowerBound",
    "completePositiveDays",
    "completeNegativeDays",
    "completeFlatDays",
    "scopeUnresolvedEvents",
    "openJournalPositions"
  ],
  "title": "TrendScorecard",
  "type": "object",
  "$id": "demo-day-scorecard-1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
